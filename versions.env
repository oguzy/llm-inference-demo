# Pinned versions for the demo. Bump these together and re-test.
# Checked against upstream releases on 2026-11-21.

# Shared gateway (make gateway)
# Gateway API / Inference Extension follow llm-d v1.0 (guides/env.sh).
# Envoy Gateway / AI Gateway follow KServe v0.21.0's tested installer.
GATEWAY_API_VERSION=v1.6.2
GAIE_VERSION=v1.6.2
LLMD_ROUTER_CRDS_VERSION=v1.0.0
ENVOY_GATEWAY_VERSION=v1.8.1
ENVOY_AI_GATEWAY_VERSION=v1.1.0

# llm-d router + simulated vLLM (make sim-*)
LLMD_ROUTER_CHART_VERSION=v1.0.0
LLMD_ROUTER_GATEWAY_CHART=oci://ghcr.io/llm-d/charts/llm-d-router-gateway
LLMD_ROUTER_STANDALONE_CHART=oci://ghcr.io/llm-d/charts/llm-d-router-standalone
LLMD_SIM_IMAGE=ghcr.io/llm-d/llm-d-inference-sim:v1.2.0

# KServe LLMInferenceService + vLLM on CPU (make kserve-*)
CERT_MANAGER_VERSION=v1.17.0
KSERVE_VERSION=v0.21.0
VLLM_CPU_IMAGE=docker.io/vllm/vllm-openai-cpu:v0.23.0

# Shell helpers (make install-kube-extras-arch)
KUBECTL_ALIASES_COMMIT=7549fa45bbde7499b927c74cae13bfb9169c9497

# Local cluster
KIND_NODE_IMAGE=kindest/node:v1.34.11
